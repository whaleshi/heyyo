# Public Reown project ID from https://dashboard.reown.com (not a private key).
# Add your deployed domain and local development origins to its allowlist.
VITE_REOWN_PROJECT_ID=

# Same-origin independent Heyyo index API. Vite proxies this path in development.
VITE_INDEXER_API_URL=/api
# Server-only dev/preview proxy target; never an Ayoo public API.
HEYYO_INDEXER_PROXY_URL=http://127.0.0.1:8787

# Public RPC must match contracts/heyyo/deployment.json (31337 for this bundle).
# Use HTTPS when the app is served over HTTPS.
VITE_HEYYO_RPC_URL=
VITE_HEYYO_NETWORK_NAME=Heyyo Development
VITE_HEYYO_NATIVE_SYMBOL=USDC
VITE_HEYYO_TEMPLATE_ID=2
VITE_HEYYO_DEX_CONFIG_ID=1
VITE_HEYYO_PAYMENT_CONFIG_ID=1

# Enable the homepage platform token strip when the platform token is ready.
VITE_SHOW_PLATFORM_TOKEN=false
