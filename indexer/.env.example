# Independent PostgreSQL; never use an Ayoo database.
INDEXER_DATABASE_URL=postgresql://heyyo:CHANGE_ME@127.0.0.1:5433/heyyo_indexer
INDEXER_RPC_URL=
# Omit chain/source/deployment/start values to use contracts/heyyo/deployment.json.
# Use two block confirmations for this deployment.
INDEXER_CONFIRMATIONS=2
INDEXER_BATCH_SIZE=100
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_API_PORT=8787

# Heyyo-owned Pinata JWT. Server-only; never use a VITE_ prefix.
PINATA_JWT=
